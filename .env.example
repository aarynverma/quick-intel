# Optional developer defaults. These are BAKED INTO THE BUILD if set —
# do NOT use these to ship a real key. Users should enter their own key
# in the Settings tab, which is stored in chrome.storage.local.
#
# Prefixed with VITE_ to be accessible via import.meta.env.
VITE_DEFAULT_PROVIDER=openai
VITE_DEFAULT_MODEL=gpt-4o-mini
